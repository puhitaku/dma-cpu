; kernel.dasm — the Phase 5d proto-kernel entry stubs (prompts/015).
;
; All scheduling POLICY lives in compiled C now (xv6/dma/kproc.c: the
; proc table, states, sleep/wakeup, exit/wait, the round-robin pick).
; This file is only the MECHANISM: two kernel entries and the
; indirection words the C side maintains to say who is current.
;
; Tick delivery is approach B (doc/abi.md) with a single injector
; (ABI ch3, timer TREQ, one-shot): it patches the RUNNING process's
; dispatch word with vecSched; the process detours here at its next
; safepoint. The C scheduler retargets the injector's WRITE_ADDR at
; every context switch and re-arms it at kernel exit only (single-fire
; discipline; fires that land while the kernel runs are absorbed by a
; kernel-owned word — see kproc.c).
;
; A syscall is a voluntary CALL (prompts/014): the process's usys stub
; indirect-calls sys_entry, leaving its return address in its own lr.
;
; Loader-patched: pKlr (&kernelC.lr), ktickv (&f_dma_ktick), ksysv
; (&f_dma_ksyscall), and the cur* seeds for the first process.
; C-maintained at every switch: pCurDisp, curThunk, pCurResume,
; nextResume.

.data
.regs
pCurDisp:   .word 0        ; &curr.dispatch (EOI target)
curThunk:   .word 0        ; curr's resume-thunk address (EOI value)
pCurResume: .word 0        ; &curr.irqresume (safepoint resume word)
curResume:  .word 0        ; saved *pCurResume (read by the C tick handler)
nextResume: .word 0        ; where to jump on kernel exit (written by C)
pKlr:       .word 0        ; &kernel-C lr
ktickv:     .word 0        ; &f_dma_ktick
ksysv:      .word 0        ; &f_dma_ksyscall
retT:       .word sched_ret
retS:       .word sys_ret
vecSched:   .word sched_entry  ; injector READ source

.text
.entry sched_entry

sched_entry:               ; tick delivered: curr's dispatch was patched
    ; EOI: restore curr's dispatch to its thunk
    move pCurDisp, se1.write
se1:
    move curThunk, @0
    ; save curr's resume point for the C tick handler
    move pCurResume, se2.read
se2:
    move @0, curResume
    ; call the C tick handler; its return lands at sched_ret
    move pKlr, se3.write
se3:
    move retT, @0
    jumpr ktickv
sched_ret:
    jumpr nextResume

sys_entry:                 ; the running process called its syscall vector
    move pKlr, sy1.write
sy1:
    move retS, @0
    jumpr ksysv
sys_ret:
    jumpr nextResume

khalt:                     ; C parks here when no process is runnable
    halt
